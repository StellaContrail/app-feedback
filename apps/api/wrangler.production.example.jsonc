{
  // 本番設定のひな形。コピー後に D1 ID と拡張機能の許可リストを設定します。
  // OAuth 認証情報は Worker secrets で管理します。
  "name": "app-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "workers_dev": true,
  "vars": {
    "EXTENSION_ORIGINS": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-feedback-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
